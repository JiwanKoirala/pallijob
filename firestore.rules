rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // Users can read only their own profile.
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Users can create their profile with a valid role.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role in [
                      'student', 'employer'
                    ];

      // Users cannot change their registered role.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.role in [
                      'student', 'employer'
                    ]
                    && request.resource.data.role ==
                       resource.data.role;

      // Profile deletion is not permitted.
      allow delete: if false;

      match /notifications/{notificationId} {
        function validNotificationFields() {
          return request.resource.data.keys().hasAll([
              'type',
              'applicationId',
              'jobTitle',
              'createdAt',
              'readAt'
            ])
            && request.resource.data.keys().hasOnly([
              'type',
              'applicationId',
              'jobTitle',
              'createdAt',
              'readAt',
              'messageId'
            ])
            && (
              (
                request.resource.data.type == 'new_message'
                && request.resource.data.messageId is string
              )
              || (
                request.resource.data.type != 'new_message'
                && !('messageId' in request.resource.data)
              )
            )
            && request.resource.data.applicationId is string
            && request.resource.data.jobTitle is string
            && request.resource.data.jobTitle.size() > 0
            && request.resource.data.createdAt == request.time
            && request.resource.data.readAt == null;
        }

        function validNewApplicationNotification() {
          let applicationPath = /databases/$(database)/documents/applications/$(request.resource.data.applicationId);
          let jobPath = /databases/$(database)/documents/jobs/$(getAfter(applicationPath).data.jobId);
          return request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
            && notificationId == 'new-application__' + request.resource.data.applicationId
            && existsAfter(applicationPath)
            && !exists(applicationPath)
            && getAfter(applicationPath).data.studentId == request.auth.uid
            && getAfter(applicationPath).data.status == 'pending'
            && getAfter(applicationPath).data.dateApplied == request.time
            && getAfter(applicationPath).data.employerId == userId
            && exists(jobPath)
            && get(jobPath).data.employerId == userId
            && request.resource.data.jobTitle == get(jobPath).data.title;
        }

        function validApplicationDecisionNotification() {
          let applicationPath = /databases/$(database)/documents/applications/$(request.resource.data.applicationId);
          let jobPath = /databases/$(database)/documents/jobs/$(get(applicationPath).data.jobId);
          let decision = request.resource.data.type == 'application_accepted'
            ? 'accepted'
            : 'rejected';
          return request.auth != null
            && request.resource.data.type in [
              'application_accepted',
              'application_rejected'
            ]
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
            && notificationId == 'status__' + decision + '__' + request.resource.data.applicationId
            && exists(applicationPath)
            && get(applicationPath).data.status == 'pending'
            && getAfter(applicationPath).data.status == decision
            && getAfter(applicationPath).data.statusUpdatedAt == request.time
            && get(applicationPath).data.studentId == userId
            && get(jobPath).data.employerId == request.auth.uid
            && request.resource.data.jobTitle == get(jobPath).data.title;
        }

        function validMessageNotification() {
          let applicationPath = /databases/$(database)/documents/applications/$(request.resource.data.applicationId);
          let jobPath = /databases/$(database)/documents/jobs/$(get(applicationPath).data.jobId);
          let messagePath = /databases/$(database)/documents/applications/$(request.resource.data.applicationId)/messages/$(request.resource.data.messageId);
          return request.auth != null
            && request.resource.data.type == 'new_message'
            && request.resource.data.messageId is string
            && notificationId == request.resource.data.applicationId + '__' + request.resource.data.messageId
            && exists(applicationPath)
            && exists(jobPath)
            && existsAfter(messagePath)
            && !exists(messagePath)
            && getAfter(messagePath).data.senderId == request.auth.uid
            && getAfter(messagePath).data.receiverId == userId
            && request.resource.data.jobTitle == get(jobPath).data.title
            && (
              (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
                && get(applicationPath).data.studentId == request.auth.uid
                && get(jobPath).data.employerId == userId
              )
              || (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
                && get(jobPath).data.employerId == request.auth.uid
                && get(applicationPath).data.studentId == userId
              )
            );
        }

        allow get, list: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid != userId
          && validNotificationFields()
          && (
            (
              request.resource.data.type == 'new_application'
              && validNewApplicationNotification()
            )
            || (
              request.resource.data.type in [
                'application_accepted',
                'application_rejected'
              ]
              && validApplicationDecisionNotification()
            )
            || validMessageNotification()
          );

        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.readAt == null
          && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']);

        allow delete: if false;
      }
    }

    match /jobs/{jobId} {
      function validWorkTypeIfProvided(data) {
        return !('workType' in data)
          || data.workType in [
            'Part-time',
            'Full-time',
            'Temporary/Contract'
          ];
      }

      function validScheduleIfProvided(data) {
        return !('schedule' in data)
          || data.schedule in [
            'Weekdays',
            'Weekends',
            'Flexible'
          ];
      }

      // Students and employers with a valid profile can view job listings.
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'student', 'employer'
        ];

      // Only accounts registered as Employer can post jobs.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
        && request.resource.data.keys().hasAll([
          'title',
          'description',
          'location',
          'requirements',
          'employerId',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'location',
          'requirements',
          'employerId',
          'createdAt',
          'workType',
          'schedule'
        ])
        && validWorkTypeIfProvided(request.resource.data)
        && validScheduleIfProvided(request.resource.data)
        && request.resource.data.employerId ==
           request.auth.uid
        && request.resource.data.createdAt ==
           request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.requirements is string
        && request.resource.data.requirements.size() > 0;

      // Employers can update only their job's editable listing fields.
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
        && resource.data.employerId == request.auth.uid
        && request.resource.data.employerId == resource.data.employerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'location',
          'requirements',
          'workType',
          'schedule'
        ])
        && validWorkTypeIfProvided(request.resource.data)
        && validScheduleIfProvided(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.requirements is string
        && request.resource.data.requirements.size() > 0;

      // Employers can delete only their own job documents.
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
        && resource.data.employerId == request.auth.uid;
    }

    match /applications/{applicationId} {
      function validApplicantNameIfProvided() {
        let name = request.resource.data.get('applicantName', null);
        let fullName = get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('fullName', null);
        // Match the Unicode whitespace trimmed by the Flutter client.
        let spaces = '[\\x{0009}-\\x{000D}\\x{0085}\\x{FEFF}\\p{Z}]+';
        return !('applicantName' in request.resource.data)
          || (name is string
            && name.matches('(?s).{1,100}')
            && fullName is string
            && name == fullName.replace('^' + spaces + '|' + spaces + '$', ''));
      }

      function notificationPath(recipientId, notificationId) {
        return /databases/$(database)/documents/users/$(recipientId)/notifications/$(notificationId);
      }

      function notificationMatchesIfPresent(recipientId, notificationId, type) {
        let path = notificationPath(recipientId, notificationId);
        return !existsAfter(path)
          || (
            getAfter(path).data.type == type
            && getAfter(path).data.applicationId == applicationId
            && getAfter(path).data.createdAt == request.time
          );
      }

      function isEmployerByApplicationField() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
          && resource.data.employerId == request.auth.uid;
      }

      function isEmployerForApplication() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
          && resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.employerId == request.auth.uid
          && (!('employerId' in resource.data)
            || resource.data.employerId ==
              get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.employerId);
      }

      function isEmployerForApplicationJob() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
          && resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.employerId == request.auth.uid;
      }

      // Students can read only their own documents; employers only their jobs' applications.
      allow get: if request.auth != null
        && (
          (resource == null
            && applicationId.matches('.*_' + request.auth.uid + '$'))
          || (resource != null
          && resource.data.studentId == request.auth.uid)
          || isEmployerByApplicationField()
          || isEmployerForApplication()
        );

      // Student and employer queries must constrain the matching ownership field.
      allow list: if request.auth != null
        && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
            && resource.data.studentId == request.auth.uid
          )
          || isEmployerByApplicationField()
          || isEmployerForApplicationJob()
        );

      // Each student can create only one pending application per existing job.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && request.resource.data.keys().hasAll([
          'jobId',
          'studentId',
          'employerId',
          'status',
          'dateApplied'
        ])
        && request.resource.data.keys().hasOnly([
          'jobId',
          'studentId',
          'employerId',
          'status',
          'dateApplied',
          'applicantName',
          'verifiedEmployerId'
        ])
        && validApplicantNameIfProvided()
        && request.resource.data.jobId is string
        && request.resource.data.jobId.size() > 0
        && request.resource.data.studentId == request.auth.uid
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && request.resource.data.employerId is string
        && request.resource.data.employerId ==
           get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId
        // The existing employerId check above binds this optional snapshot to the job owner.
        && (!('verifiedEmployerId' in request.resource.data)
          || (request.resource.data.verifiedEmployerId == request.resource.data.employerId
            && request.resource.data.employerId.size() > 0))
        && request.resource.data.status == 'pending'
        && request.resource.data.dateApplied == request.time
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && notificationMatchesIfPresent(
          request.resource.data.employerId,
          'new-application__' + applicationId,
          'new_application'
        );

      // The owning Employer may make one final decision by changing status only.
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
        && isEmployerForApplication()
        && resource.data.jobId is string
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && (
          (
            !('statusUpdatedAt' in resource.data)
            && !('statusUpdatedAt' in request.resource.data)
            && !existsAfter(notificationPath(
              resource.data.studentId,
              'status__' + request.resource.data.status + '__' + applicationId
            ))
          )
          || (
            request.resource.data.statusUpdatedAt == request.time
            && existsAfter(notificationPath(
              resource.data.studentId,
              'status__' + request.resource.data.status + '__' + applicationId
            ))
            && notificationMatchesIfPresent(
              resource.data.studentId,
              'status__' + request.resource.data.status + '__' + applicationId,
              'application_' + request.resource.data.status
            )
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'statusUpdatedAt'
        ]);
    }

    match /applications/{applicationId}/messages/{messageId} {
      function notificationPath(recipientId, notificationId) {
        return /databases/$(database)/documents/users/$(recipientId)/notifications/$(notificationId);
      }

      function messageNotificationMatchesIfPresent(recipientId) {
        let path = notificationPath(
          recipientId,
          applicationId + '__' + messageId
        );
        return !existsAfter(path)
          || (
            getAfter(path).data.type == 'new_message'
            && getAfter(path).data.applicationId == applicationId
            && getAfter(path).data.messageId == messageId
            && getAfter(path).data.createdAt == request.time
          );
      }

      function validChatParents() {
        return exists(/databases/$(database)/documents/applications/$(applicationId))
          && get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId is string
          && get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId.size() > 0
          && get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId is string
          && get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId.size() > 0
          && exists(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId))
          && get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId is string
          && get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId.size() > 0
          && get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId !=
            get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId
          && (!('employerId' in get(/databases/$(database)/documents/applications/$(applicationId)).data)
            || get(/databases/$(database)/documents/applications/$(applicationId)).data.employerId ==
              get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId);
      }

      function isChatParticipant() {
        return request.auth != null
          && validChatParents()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
              && get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId == request.auth.uid
            )
            || (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
              && get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId == request.auth.uid
            )
          );
      }

      allow get, list: if isChatParticipant();

      allow create: if isChatParticipant()
        && request.resource.data.keys().hasAll([
          'senderId',
          'receiverId',
          'content',
          'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'senderId',
          'receiverId',
          'content',
          'timestamp'
        ])
        && request.resource.data.senderId == request.auth.uid
        && (
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
            && request.resource.data.senderId ==
              get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId
            && request.resource.data.receiverId ==
              get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId
          )
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
            && request.resource.data.senderId ==
              get(/databases/$(database)/documents/jobs/$(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId)).data.employerId
            && request.resource.data.receiverId ==
              get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId
          )
        )
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.content.matches('.*\\S.*')
        && request.resource.data.timestamp == request.time
        && messageNotificationMatchesIfPresent(request.resource.data.receiverId);

      allow update, delete: if false;
    }
  }
}
